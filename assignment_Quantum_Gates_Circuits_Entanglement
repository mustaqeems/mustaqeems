from qiskit import QuantumCircuit
from qiskit_aer import AerSimulator
from qiskit.quantum_info import Statevector
from qiskit.visualization import plot_histogram
import matplotlib.pyplot as plt

def bell_state(name, prep_gates):
    qc_sv = QuantumCircuit(2)
    for q in prep_gates:
        qc_sv.x(q)
    qc_sv.h(0)
    qc_sv.cx(0, 1)
    state = Statevector.from_instruction(qc_sv)

    print(f"\n=== {name} ===")
    print(qc_sv.draw(output="text"))
    print("Statevector:", state)
    probs = state.probabilities_dict()
    print("Probabilities:", probs)

    qc_meas = QuantumCircuit(2, 2)
    for q in prep_gates:
        qc_meas.x(q)
    qc_meas.h(0)
    qc_meas.cx(0, 1)
    qc_meas.measure([0, 1], [0, 1])

    sim = AerSimulator()
    counts = sim.run(qc_meas, shots=1024).result().get_counts()
    print("Counts (1024 shots):", counts)
    plot_histogram(counts, title=name)
    plt.show()

    return state, probs, counts

results = {}
results["Phi+"] = bell_state("Phi+", [])
results["Phi-"] = bell_state("Phi-", [0])
results["Psi+"] = bell_state("Psi+", [1])
results["Psi-"] = bell_state("Psi-", [0, 1])

